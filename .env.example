DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# DATABASE_URL=postgresql://user:password@localhost:5432/cofounder_ai

# demo, gigachat, cloudru, openai или anthropic
AI_PROVIDER=demo
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-3-Pro
# Путь к доверенному PEM-файлу сертификата Минцифры, если он не установлен в macOS
GIGACHAT_CA_BUNDLE=
# Если основной адрес недоступен, запросы сами уходят на запасной.
# GIGACHAT_FALLBACK_URL=https://gigachat.devices.sberbank.ru/api/v1
# GIGACHAT_FALLBACK_MODEL=GigaChat-2-Max
CLOUDRU_API_KEY=
CLOUDRU_MODEL=ai-sage/GigaChat3-10B-A1.8B
# Separate code generator. AI_PROVIDER above still selects Bruno's chat model.
QWEN_CODE_MODEL=Qwen/Qwen3-Coder-Next
QWEN_CODE_MAX_TOKENS=16384
QWEN_CODE_TIMEOUT=300
# Personal daily generation cap; 0 temporarily disables it for development.
LAB_REQUESTS_PER_DAY=10
LAB_GLOBAL_REQUESTS_PER_DAY=30
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

TELEGRAM_BOT_TOKEN=
TELEGRAM_MINI_APP_URL=

# Redis нужен для WebSocket между несколькими процессами/серверами.
# Для одного локального сервера можно оставить пустым.
REDIS_URL=
# На этом Mac: redis://127.0.0.1:6387/0; start.command запустит .tools/valkey-server.
# В production укажите адрес управляемого Redis/Valkey.

# Ограничения дорогих операций на один аккаунт (чат, радар, карточка, задания, питч).
AI_REQUESTS_PER_MINUTE=12
AI_REQUESTS_PER_DAY=200
# При публичном размещении: DJANGO_DEBUG=0, свой SECRET_KEY и точные ALLOWED_HOSTS.
# Включать только за доверенным HTTPS-прокси, закрывающим прямой доступ к серверу:
# DJANGO_TRUST_PROXY_HTTPS=1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example

# Laboratory token savings and cost guardrails (RUB; not subscription billing).
# Separate from the regular Bruno chat model. Known paid-equivalent Pro tariff:
LAB_BRUNO_MODEL=GigaChat-2-Pro
LAB_BRUNO_PRICE_MODEL=GigaChat-2-Pro
LAB_BRUNO_RUB_PER_MILLION=500
LAB_CREATE_MAX_TOKENS=16384
LAB_PATCH_MAX_TOKENS=2048
LAB_PATCH_MAX_RESPONSE_CHARS=24000
LAB_PATCH_MAX_FIND_CHARS=6000
LAB_PATCH_MAX_REPLACEMENT_CHARS=12000
LAB_CREATE_TEMPERATURE=0.6
LAB_PATCH_TEMPERATURE=0.2
QWEN_INPUT_BYTE_LIMIT=32000
# Native Cloud.ru daytime tariff, incl. VAT, verified 2026-10-07.
# Update ALL three fields if changing model or tariff.
QWEN_PRICE_MODEL=Qwen/Qwen3-Coder-Next
QWEN_INPUT_RUB_PER_MILLION=122
QWEN_OUTPUT_RUB_PER_MILLION=244
LAB_MAX_REQUEST_RUB=10
LAB_USER_DAILY_RUB=20
LAB_USER_MONTHLY_RUB=100
LAB_GLOBAL_DAILY_RUB=200
LAB_GLOBAL_MONTHLY_RUB=2000
BRUNO_HISTORY_CHAR_LIMIT=20000
