# Only this site's own settings. ZIP never includes .env.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# For public deployment: DEBUG=0, a unique secret and HTTPS.
DJANGO_SECRET_KEY=

# Local reset emails go to the server log, never to a public page.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# For real email: django.core.mail.backends.smtp.EmailBackend.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=noreply@localhost
EMAIL_NOTIFICATIONS_ENABLED=0

# Your own application's shop (test keys first).
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
PAYMENT_RETURN_BASE=
# Webhook path: /payments/webhook/

# For multiple ASGI workers; unnecessary for one local process.
REDIS_URL=
WS_ALLOWED_ORIGINS=
